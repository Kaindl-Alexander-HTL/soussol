# SOUS SOL — lokale Dev-Umgebung. Kopiere diese Datei nach .env.local und fülle die Werte.

# ── Supabase (dein eigenes Projekt: Dashboard → Settings → API) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=DEIN_SERVICE_ROLE_KEY

# ── Zugangs-Cookie-Signatur (beliebiger langer Zufallsstring) ────────────────
ACCESS_COOKIE_SECRET=irgendein-langer-zufallsstring-hier

# ── Resend (E-Mail). Fuers lokale Klicken reicht ein Dummy — Mails schlagen ──
# dann still fehl (fire-and-forget), die App laeuft trotzdem.
RESEND_API_KEY=re_dummy
ADMIN_EMAIL=du@example.com

# ── Site-URL (fuer Invite-Links). Lokal: ────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (Test-Mode). Secret-Key aus dem Stripe-Dashboard (Test-Toggle an) ─
STRIPE_SECRET_KEY=sk_test_DEIN_TEST_KEY
# whsec_... kommt aus `stripe listen` (siehe Runbook), danach hier eintragen:
STRIPE_WEBHOOK_SECRET=whsec_AUS_STRIPE_LISTEN

# Kommagetrennte Liste der Admin-Adressen. Ohne diese Variable kommt NIEMAND ins Backoffice.
ADMIN_EMAILS=
